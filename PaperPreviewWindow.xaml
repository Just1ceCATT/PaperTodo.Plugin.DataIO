<Window x:Class="PaperTodo.Plugin.DataIo.PaperPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览"
        Width="560"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="PreviewButton" TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource DialogTintBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontFamily" Value="{DynamicResource DialogIconFontFamily}" />
      <Setter Property="Foreground" Value="{DynamicResource DialogWeakBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    CornerRadius="6"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogTintBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell"
          CornerRadius="10"
          BorderThickness="1"
          Padding="20"
          Background="{DynamicResource DialogPaperBrush}"
          BorderBrush="{DynamicResource DialogBorderBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Color="Black" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题与类型 -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText"
                     Text="预览"
                     FontWeight="Bold"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource DialogTextBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border x:Name="TypeBadge"
                    Padding="7,2"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource DialogTintBrush}">
              <TextBlock x:Name="TypeText"
                         Foreground="{DynamicResource DialogAccentBrush}" />
            </Border>
            <TextBlock x:Name="MetaText"
                       Margin="9,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource DialogWeakBrush}" />
          </StackPanel>
        </StackPanel>
        <Button x:Name="CloseIconButton"
                Grid.Column="1"
                Margin="12,-4,-4,0"
                VerticalAlignment="Top"
                Style="{StaticResource IconButton}"
                Content="&#xE711;"
                ToolTip="关闭" />
      </Grid>

      <TextBlock x:Name="WarningText"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Visibility="Collapsed"
                 Foreground="{DynamicResource DialogWarningBrush}" />

      <!-- 正文 -->
      <Border Grid.Row="2"
              Margin="0,14,0,0"
              Padding="0"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource DialogBorderBrush}"
              Background="{DynamicResource DialogSurfaceBrush}">
        <ScrollViewer x:Name="BodyScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
          <!-- ScrollViewer 的默认模板会忽略 Padding，内边距必须放在内容上。 -->
          <StackPanel x:Name="BodyPanel" Margin="16,14,16,14" />
        </ScrollViewer>
      </Border>

      <!-- 底部导航与操作 -->
      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PrevButton"
                  Style="{StaticResource IconButton}"
                  Content="&#xE76B;"
                  ToolTip="上一条（←）" />
          <TextBlock x:Name="CounterText"
                     MinWidth="52"
                     Margin="4,0"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource DialogWeakBrush}" />
          <Button x:Name="NextButton"
                  Style="{StaticResource IconButton}"
                  Content="&#xE76C;"
                  ToolTip="下一条（→）" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="CopyButton"
                  Content="复制正文"
                  Margin="0,0,8,0"
                  Style="{StaticResource PreviewButton}" />
          <Button x:Name="SelectButton"
                  Content="加入导出"
                  Margin="0,0,8,0"
                  Style="{StaticResource PreviewButton}" />
          <Button x:Name="DoneButton"
                  Content="关闭"
                  IsDefault="True"
                  Style="{StaticResource PreviewButton}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
