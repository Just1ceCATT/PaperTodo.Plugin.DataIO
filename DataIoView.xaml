<UserControl x:Class="PaperTodo.Plugin.DataIo.DataIoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource DataIoFontFamily}"
             FontSize="{DynamicResource DataIoFontSize}">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DataIoBorderBrush}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DataIoBorderBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="16,13,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题与说明 -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="纸片数据导入导出"
                 FontWeight="SemiBold"
                 FontSize="{DynamicResource DataIoTitleFontSize}"
                 Foreground="{DynamicResource DataIoTextBrush}" />
      <TextBlock x:Name="HintText"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource DataIoWeakFontSize}"
                 Foreground="{DynamicResource DataIoWeakBrush}"
                 Text="勾选纸片后导出为 JSON；导入时一律追加为新纸片，不会覆盖现有数据。" />
    </StackPanel>

    <!-- 筛选与批量选择 -->
    <WrapPanel Grid.Row="1" Margin="0,12,0,10">
      <CheckBox x:Name="SelectAllCheckBox" Content="全选" Margin="0,0,12,0" />
      <Button x:Name="InvertButton" Content="反选" Margin="0,0,10,0" />
      <ComboBox x:Name="FilterBox" Width="100" Margin="0,0,8,0" />
      <TextBox x:Name="SearchBox" Width="200" ToolTip="按标题搜索" />
    </WrapPanel>

    <!-- 纸片列表 -->
    <ListBox x:Name="PaperList"
             Grid.Row="2"
             Background="Transparent"
             BorderThickness="0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="10,8"
                  Margin="0,0,0,6"
                  BorderThickness="1"
                  CornerRadius="7"
                  BorderBrush="{DynamicResource DataIoBorderBrush}"
                  Background="{DynamicResource DataIoSurfaceBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <CheckBox Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        IsEnabled="{Binding CanSelect}" />

              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DataIoTextBrush}" />
                <TextBlock Text="{Binding Summary}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource DataIoWeakFontSize}"
                           Foreground="{DynamicResource DataIoWeakBrush}" />
                <TextBlock Text="{Binding Warning}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource DataIoWeakFontSize}"
                           Foreground="{DynamicResource DataIoWarningBrush}"
                           Visibility="{Binding WarningVisibility}" />
              </StackPanel>

              <Border Grid.Column="2"
                      Margin="8,0,0,0"
                      Padding="6,2"
                      CornerRadius="4"
                      VerticalAlignment="Top"
                      Background="{DynamicResource DataIoAccentSurfaceBrush}">
                <TextBlock Text="{Binding TypeLabel}"
                           FontSize="{DynamicResource DataIoWeakFontSize}"
                           Foreground="{DynamicResource DataIoAccentBrush}" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 操作按钮 -->
    <WrapPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Right">
      <Button x:Name="ExportButton" Content="导出所选" />
      <Button x:Name="ImportButton" Content="导入文件" />
    </WrapPanel>

    <!-- 状态栏与进度 -->
    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText"
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource DataIoWeakFontSize}"
                 Foreground="{DynamicResource DataIoWeakBrush}" />
      <ProgressBar x:Name="BusyBar"
                   Grid.Column="1"
                   Width="120"
                   Height="4"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   IsIndeterminate="True"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource DataIoAccentBrush}" />
    </Grid>
  </Grid>
</UserControl>
