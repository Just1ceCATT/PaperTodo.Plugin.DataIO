<UserControl x:Class="PaperTodo.Plugin.DataIo.DataIoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource DataIoFontFamily}"
             FontSize="{DynamicResource DataIoFontSize}">
  <UserControl.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource DataIoSectionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
    </Style>
    <Style x:Key="SectionHint" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{DynamicResource DataIoWeakFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
    </Style>
    <Style x:Key="RowBorder" TargetType="Border">
      <Setter Property="Padding" Value="{DynamicResource DataIoRowPadding}" />
      <Setter Property="Margin" Value="{DynamicResource DataIoRowMargin}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="{DynamicResource DataIoDividerMargin}" />
      <Setter Property="Background" Value="{DynamicResource DataIoDividerBrush}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource DataIoIconFontFamily}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="{DynamicResource DataIoWeakFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
    </Style>

    <!-- 行内预览入口：低干扰图标按钮，悬停时才浮现底色 -->
    <Style x:Key="RowIconButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    CornerRadius="5"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 条目行：透明容器 + 轻量分割线，悬停时才浮现底色 -->
    <Style x:Key="PaperListRow" TargetType="Border">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DataIoDividerBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 展开后的具体纸片行：紧凑列表，减少重复卡片与边框 -->
    <DataTemplate x:Key="PaperRowTemplate">
      <Border Style="{StaticResource PaperListRow}"
              MouseLeftButtonDown="OnRowMouseLeftButtonDown"
              MouseEnter="OnRowMouseEnter"
              MouseLeave="OnRowMouseLeave"
              MouseMove="OnRowMouseMove">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <!-- 未选中降低对比度，选中后回到正文色 -->
                  <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Summary}"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource DataIoWeakFontSize}"
                       Foreground="{DynamicResource DataIoWeakBrush}" />
            <TextBlock Text="{Binding Warning}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource DataIoWeakFontSize}"
                       Foreground="{DynamicResource DataIoWarningBrush}"
                       Visibility="{Binding WarningVisibility}" />
          </StackPanel>
          <!-- 类型标签与预览按钮同处一个水平容器，统一垂直居中 -->
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Border Margin="8,0,0,0"
                    Padding="7,2"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource DataIoAccentSurfaceBrush}">
              <TextBlock Text="{Binding TypeLabel}"
                         FontSize="{DynamicResource DataIoWeakFontSize}"
                         Foreground="{DynamicResource DataIoAccentBrush}" />
            </Border>
            <Button Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource RowIconButton}"
                    Click="OnPreviewRowClick"
                    ToolTip="预览正文">
              <TextBlock Text="&#xE7B3;"
                         FontFamily="{DynamicResource DataIoIconFontFamily}"
                         FontSize="13" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- 模式卡片：同一 GroupName 的 RadioButton 天然互斥 -->
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Card"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="Transparent"
                    BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource DataIoAccentSurfaceBrush}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DataIoAccentBorderBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FormatChoice" TargetType="RadioButton" BasedOn="{StaticResource ModeCard}">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="{DynamicResource DataIoWeakFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="{DynamicResource DataIoPrimaryHeight}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource DataIoFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoOnAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource DataIoAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DataIoBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 批量选择操作：无边框、小字号，只在悬停时浮现底色，避免抢占列表注意力 -->
    <Style x:Key="CompactGhostButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="{DynamicResource DataIoWeakFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DataIoSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 与宿主原生待办勾选框一致：直接复用 PaperWindow 的主题资源键 -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckBorder"
                      Width="{DynamicResource DataIoCheckSize}"
                      Height="{DynamicResource DataIoCheckSize}"
                      BorderThickness="{DynamicResource DataIoCheckBorderThickness}"
                      CornerRadius="{DynamicResource DataIoCheckCornerRadius}"
                      BorderBrush="{DynamicResource CheckBoxBorderBrushKey}"
                      Background="Transparent"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                <!-- 与宿主原生一致：不固定宽高，按几何自然尺寸居中，再整体缩放 -->
                <Path x:Name="CheckMark"
                      Data="M 3,7.5 L 6.5,11 L 13,4"
                      Stroke="{DynamicResource PaperBrushKey}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      SnapsToDevicePixels="True">
                  <Path.LayoutTransform>
                    <ScaleTransform ScaleX="{DynamicResource DataIoCheckScale}"
                                    ScaleY="{DynamicResource DataIoCheckScale}" />
                  </Path.LayoutTransform>
                </Path>
              </Border>
              <ContentPresenter x:Name="Label"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Label" Property="Margin" Value="0" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CheckBoxActiveBrushKey}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="CheckBorder" Property="BorderThickness" Value="0" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource CheckBoxUncheckedHoverBorderBrushKey}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CheckBoxUncheckedHoverBgKey}" />
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CheckBoxActiveHoverBrushKey}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="CheckBorder" Property="BorderThickness" Value="0" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="RootGrid" Margin="18,16,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部标题 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="数据传输"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 FontSize="{DynamicResource DataIoTitleFontSize}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource DataIoTextBrush}" />
      <Border x:Name="HeaderBadge"
              Grid.Column="1"
              CornerRadius="6"
              Padding="8,3"
              BorderThickness="1"
              BorderBrush="{DynamicResource DataIoAccentBorderBrush}"
              Background="{DynamicResource DataIoAccentSurfaceBrush}">
        <TextBlock Text="PaperTodo"
                   FontSize="{DynamicResource DataIoWeakFontSize}"
                   Foreground="{DynamicResource DataIoAccentBrush}" />
      </Border>
    </Grid>

    <!-- 导出 / 导入模式：窄纸片自动改为上下排列 -->
    <UniformGrid x:Name="ModeCardsGrid"
                 Grid.Row="1"
                 Columns="2"
                 Margin="0,14,0,0">
      <RadioButton x:Name="ExportModeButton"
                   Margin="0,0,5,0"
                   GroupName="DataIoMode"
                   Style="{StaticResource ModeCard}"
                   IsChecked="True">
        <StackPanel>
          <TextBlock Text="&#xE898;"
                     HorizontalAlignment="Center"
                     FontSize="18">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=ExportModeButton}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DataIoAccentBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="导出数据"
                     Margin="0,5,0,0"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=ExportModeButton}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DataIoAccentBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="ExportModeSubtitle"
                     Text="选择内容并生成文件"
                     Margin="0,3,0,0"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource DataIoWeakFontSize}"
                     Foreground="{DynamicResource DataIoWeakBrush}" />
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="ImportModeButton"
                   Margin="5,0,0,0"
                   GroupName="DataIoMode"
                   Style="{StaticResource ModeCard}">
        <StackPanel>
          <TextBlock Text="&#xE896;"
                     HorizontalAlignment="Center"
                     FontSize="18">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Foreground" Value="{DynamicResource DataIoWeakBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=ImportModeButton}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DataIoAccentBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="导入数据"
                     Margin="0,5,0,0"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DataIoTextBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=ImportModeButton}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DataIoAccentBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="ImportModeSubtitle"
                     Text="从文件恢复内容"
                     Margin="0,3,0,0"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource DataIoWeakFontSize}"
                     Foreground="{DynamicResource DataIoWeakBrush}" />
        </StackPanel>
      </RadioButton>
    </UniformGrid>

    <!-- 可滚动内容 -->
    <ScrollViewer x:Name="SummaryScroll"
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="SummaryPanel" Margin="0,0,4,0">

        <!-- 导入文件（仅导入模式） -->
        <StackPanel x:Name="ImportFileSection" Visibility="Collapsed">
          <TextBlock Text="导入文件" Style="{StaticResource SectionTitle}" />
          <!-- 紧凑文件信息行：图标 | 文件名 + 状态 | 重新选择 -->
          <Border Style="{StaticResource RowBorder}" Margin="0,8,0,0" Padding="10,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="16" />
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ImportFileNameText"
                           Text="尚未选择文件"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource DataIoTextBrush}" />
                <TextBlock x:Name="ImportFileStatusText"
                           Margin="0,2,0,0"
                           Text="支持 PaperTodo JSON 或 Markdown 文档 (*.md)"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource DataIoWeakFontSize}"
                           Foreground="{DynamicResource DataIoWeakBrush}" />
              </StackPanel>
              <Button x:Name="ChooseFileButton"
                      Grid.Column="2"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      Content="选择文件"
                      Style="{StaticResource GhostButton}" />
            </Grid>
          </Border>
          <TextBlock x:Name="ImageWarningText"
                     Margin="2,8,2,0"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource DataIoWeakFontSize}"
                     Foreground="{DynamicResource DataIoWarningBrush}"
                     Visibility="Collapsed" />
        </StackPanel>

        <!-- 导出格式放在导出内容之前 -->
        <Grid x:Name="FormatRow" Margin="0,14,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="导出格式" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <RadioButton x:Name="JsonFormatButton"
                         Content="JSON"
                         GroupName="DataIoExportFormat"
                         Style="{StaticResource FormatChoice}"
                         IsChecked="True" />
            <RadioButton x:Name="MarkdownFormatButton"
                         Content="Markdown"
                         GroupName="DataIoExportFormat"
                         Style="{StaticResource FormatChoice}"
                         Margin="6,0,0,0" />
          </StackPanel>
        </Grid>

        <!-- 内容类型：点击行就地展开 -->
        <TextBlock x:Name="ContentSectionTitle"
                   Text="导出内容"
                   Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="ContentSectionHint"
                   Text="点击条目展开并选择具体内容"
                   Style="{StaticResource SectionHint}" />

        <Border x:Name="NotesRow"
                Style="{StaticResource RowBorder}"
                Margin="0,8,0,0"
                Padding="10,7"
                Cursor="Hand">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       Text="笔记"
                       Style="{StaticResource RowTitle}" />
            <TextBlock x:Name="NotesCountText"
                       Grid.Column="2"
                       Text="0 条"
                       Style="{StaticResource RowValue}" />
            <TextBlock x:Name="NotesChevron"
                       Grid.Column="3"
                       Margin="12,0,0,0"
                       Text="&#xE76C;"
                       Style="{StaticResource Icon}"
                       FontSize="12"
                       RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform x:Name="NotesChevronRotate" Angle="0" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Grid>
        </Border>
        <Border x:Name="NotesPanel"
                Height="0"
                Visibility="Collapsed"
                ClipToBounds="True">
          <StackPanel x:Name="NotesContent" Margin="0,2,0,2">
            <WrapPanel Margin="0,0,0,2">
              <Button x:Name="NotesSelectAllButton"
                      Content="全选"
                      Style="{StaticResource CompactGhostButton}"
                      Margin="0,0,6,0" />
              <Button x:Name="NotesClearButton"
                      Content="清空"
                      Style="{StaticResource CompactGhostButton}"
                      Margin="0,0,6,0" />
              <Button x:Name="NotesInvertButton"
                      Content="反选"
                      Style="{StaticResource CompactGhostButton}" />
            </WrapPanel>
            <ItemsControl x:Name="NotesList" ItemTemplate="{StaticResource PaperRowTemplate}" />
          </StackPanel>
        </Border>

        <Border x:Name="TodosRow"
                Style="{StaticResource RowBorder}"
                Margin="0,6,0,0"
                Padding="10,7"
                Cursor="Hand">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       Text="待办事项"
                       Style="{StaticResource RowTitle}" />
            <TextBlock x:Name="TodosCountText"
                       Grid.Column="2"
                       Text="0 条"
                       Style="{StaticResource RowValue}" />
            <TextBlock x:Name="TodosChevron"
                       Grid.Column="3"
                       Margin="12,0,0,0"
                       Text="&#xE76C;"
                       Style="{StaticResource Icon}"
                       FontSize="12"
                       RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform x:Name="TodosChevronRotate" Angle="0" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Grid>
        </Border>
        <Border x:Name="TodosPanel"
                Height="0"
                Visibility="Collapsed"
                ClipToBounds="True">
          <StackPanel x:Name="TodosContent" Margin="0,2,0,2">
            <WrapPanel Margin="0,0,0,2">
              <Button x:Name="TodosSelectAllButton"
                      Content="全选"
                      Style="{StaticResource CompactGhostButton}"
                      Margin="0,0,6,0" />
              <Button x:Name="TodosClearButton"
                      Content="清空"
                      Style="{StaticResource CompactGhostButton}"
                      Margin="0,0,6,0" />
              <Button x:Name="TodosInvertButton"
                      Content="反选"
                      Style="{StaticResource CompactGhostButton}" />
            </WrapPanel>
            <ItemsControl x:Name="TodosList" ItemTemplate="{StaticResource PaperRowTemplate}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Divider}" />

        <!-- 预估 -->
        <TextBlock x:Name="EstimateTitle"
                   Text="导出预估"
                   Style="{StaticResource SectionHint}" />
        <TextBlock x:Name="EstimateMain"
                   Text="0 条笔记 · 0 条待办"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource DataIoEstimateFontSize}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DataIoTextBrush}" />
        <TextBlock x:Name="EstimateSub"
                   Text="包含标题、待办与笔记正文等必要元数据"
                   Style="{StaticResource SectionHint}" />
      </StackPanel>
    </ScrollViewer>

    <!-- 主操作按钮 -->
    <Button x:Name="PrimaryButton"
            Grid.Row="3"
            Content="导出所选内容"
            Style="{StaticResource PrimaryButton}"
            Margin="0,14,0,0" />

    <!-- 状态栏 -->
    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText"
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource DataIoWeakFontSize}"
                 Foreground="{DynamicResource DataIoWeakBrush}" />
      <ProgressBar x:Name="BusyBar"
                   Grid.Column="1"
                   Width="120"
                   Height="4"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   IsIndeterminate="True"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource DataIoAccentBrush}" />
    </Grid>

    <!-- 悬停快速预览：只读浮层，跟随鼠标出现，不抢焦点 -->
    <Popup x:Name="HoverPreviewPopup"
           AllowsTransparency="True"
           Focusable="False"
           IsHitTestVisible="False"
           Placement="MousePoint"
           StaysOpen="True">
      <Border x:Name="HoverCard"
              Margin="6"
              MaxWidth="360"
              Padding="14,12"
              CornerRadius="9"
              BorderThickness="1"
              Background="{DynamicResource DataIoCardBrush}"
              BorderBrush="{DynamicResource DataIoBorderBrush}"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TranslateTransform x:Name="HoverCardTranslate" />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Color="Black" />
        </Border.Effect>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HoverTitle"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DataIoTextBrush}" />
            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="6,1"
                    CornerRadius="4"
                    VerticalAlignment="Top"
                    Background="{DynamicResource DataIoAccentSurfaceBrush}">
              <TextBlock x:Name="HoverType"
                         FontSize="{DynamicResource DataIoWeakFontSize}"
                         Foreground="{DynamicResource DataIoAccentBrush}" />
            </Border>
          </Grid>
          <TextBlock x:Name="HoverMeta"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource DataIoWeakFontSize}"
                     Foreground="{DynamicResource DataIoWeakBrush}" />
          <TextBlock x:Name="HoverWarning"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource DataIoWeakFontSize}"
                     Foreground="{DynamicResource DataIoWarningBrush}"
                     Visibility="Collapsed" />
          <Border Margin="0,8,0,0"
                  Padding="9,7"
                  CornerRadius="6"
                  Background="{DynamicResource DataIoSurfaceBrush}">
            <TextBlock x:Name="HoverExcerpt"
                       MaxWidth="320"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       FontSize="{DynamicResource DataIoFontSize}"
                       Foreground="{DynamicResource DataIoTextBrush}" />
          </Border>
          <TextBlock Text="点击行内预览按钮查看全文"
                     Margin="0,7,0,0"
                     FontSize="{DynamicResource DataIoWeakFontSize}"
                     Foreground="{DynamicResource DataIoWeakBrush}" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
