<Window x:Class="PaperTodo.Plugin.DataIo.DataIoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource DialogWeakBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell"
          MinWidth="320"
          MaxWidth="540"
          CornerRadius="12"
          BorderThickness="1"
          Padding="22"
          Background="{DynamicResource DialogPaperBrush}"
          BorderBrush="{DynamicResource DialogBorderBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.32" Color="Black" />
    </Border.Effect>

    <StackPanel>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconBadge"
                Width="34"
                Height="34"
                CornerRadius="17"
                Background="{DynamicResource DialogAccentSurfaceBrush}">
          <TextBlock x:Name="IconText"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource DialogAccentBrush}" />
        </Border>

        <TextBlock x:Name="TitleText"
                   Grid.Column="1"
                   Margin="10,0,10,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource DialogTextBrush}" />

        <Button x:Name="CloseButton"
                Grid.Column="2"
                Style="{StaticResource CloseButton}"
                Content="✕" />
      </Grid>

      <StackPanel x:Name="BodyPanel" />

      <StackPanel x:Name="ButtonPanel"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,18,0,0" />
    </StackPanel>
  </Border>
</Window>
