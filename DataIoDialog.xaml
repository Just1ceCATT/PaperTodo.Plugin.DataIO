<Window x:Class="PaperTodo.Plugin.DataIo.DataIoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell"
          CornerRadius="10"
          BorderThickness="1"
          Padding="18"
          Background="{DynamicResource DialogPaperBrush}"
          BorderBrush="{DynamicResource DialogBorderBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Color="Black" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="TitleText"
                 Grid.Row="0"
                 Margin="0,0,0,8"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource DialogTextBrush}" />

      <StackPanel x:Name="BodyPanel" Grid.Row="1" />

      <WrapPanel x:Name="ButtonPanel"
                 Grid.Row="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 Margin="0,16,0,0" />
    </Grid>
  </Border>
</Window>
